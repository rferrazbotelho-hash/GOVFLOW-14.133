PORT=3001
# Modo 'auto' (padrão): detecta credenciais Gemini/Google ou OpenAI (OPENAI_API_KEY) automaticamente no ambiente/.env/ADC.
# Para priorizar OpenAI diretamente, defina AI_PROVIDER=openai e informe OPENAI_API_KEY.
AI_PROVIDER=auto
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_QUOTA_PROJECT=
GEMINI_MODEL=gemini-4-hydrogen
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Credenciais iniciais do Administrador (criadas apenas se ainda não existir usuário ADMIN no SQLite)
GOVFLOW_ADMIN_USERNAME=admin
GOVFLOW_ADMIN_PASSWORD=GovFlow@14133
GOVFLOW_ADMIN_EMAIL=rodrigofb@live.com
