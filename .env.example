PORT=3001
# Modo 'auto' (padrão): detecta credenciais Gemini/Google automaticamente no ambiente, arquivo .env ou
# Google Cloud Application Default Credentials (gcloud auth application-default login / GOOGLE_APPLICATION_CREDENTIALS),
# sem exigir inserção manual de token na interface. Sem credenciais externas, opera 100% offline no Motor Local 14.133.
AI_PROVIDER=auto
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_QUOTA_PROJECT=
GEMINI_MODEL=gemini-4-hydrogen
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
